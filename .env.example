# Copie este arquivo para .env.local e substitua pelos dados do seu projeto.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Em desenvolvimento, "open" permite testar o cadastro.
# Em produção, use "invite_only" e desative novos cadastros no painel do Supabase.
REGISTRATION_MODE=open
